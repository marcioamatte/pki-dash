# Sign in with Keycloak (or another OpenID Connect provider). Optional.
#
# To turn it on:
#   sudo cp /etc/pki-dash/oidc.env.example /etc/pki-dash/oidc.env
#   sudo $EDITOR /etc/pki-dash/oidc.env
#   sudo systemctl restart pki-dash
# While /etc/pki-dash/oidc.env does not exist, SSO is off and only local accounts sign in.
# The full guide, including what to set up in Keycloak, is docs/05-sso-keycloak.md.

# The realm's issuer URL.
PKI_DASH_OIDC_ISSUER=https://keycloak.lab/realms/lab
PKI_DASH_OIDC_CLIENT_ID=pki-dash

# How browsers reach pki-dash (scheme and host only). The redirect address is built from it
# and must match what you registered in Keycloak.
PKI_DASH_EXTERNAL_URL=https://pki.lab:8443

# The client secret lives in its own file, readable by the service and nobody else:
#   sudo install -m 0640 -o root -g pki-dash /dev/null /etc/pki-dash/oidc-secret
#   echo 'the-client-secret' | sudo tee /etc/pki-dash/oidc-secret >/dev/null
PKI_DASH_OIDC_CLIENT_SECRET_FILE=/etc/pki-dash/oidc-secret

# Label on the button.
PKI_DASH_OIDC_NAME=Keycloak

# Which groups become which role. Someone in none of them cannot sign in.
PKI_DASH_OIDC_ADMIN_GROUPS=pki-admins
PKI_DASH_OIDC_OPERATOR_GROUPS=pki-operators
PKI_DASH_OIDC_VIEWER_GROUPS=pki-viewers

# If Keycloak's certificate comes from your own CA, point to that CA (PEM):
#PKI_DASH_OIDC_CA_FILE=/etc/pki-dash/ca.pem
