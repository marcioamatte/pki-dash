[Unit]
Description=pki-dash: web dashboard for an internal PKI
Documentation=https://github.com/marcioamatte/pki-dash
After=network-online.target
Wants=network-online.target
# A configuration mistake makes the server exit at once. Retry a few times
# (the provider or the network may just be late), then stop and wait to be fixed
# instead of restarting forever. After fixing the settings, run
#   systemctl reset-failed pki-dash && systemctl restart pki-dash
# because systemd will not start a unit that has just hit this limit until it is reset.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pki-dash
Group=pki-dash
# The main settings. Edit this file before the first start: the server refuses
# to run until you choose how it is served (TLS certificate, self-signed, or
# plain HTTP behind a proxy).
EnvironmentFile=/etc/pki-dash/pki-dash.env
# Optional: sign in through Keycloak or another OpenID Connect provider. The file
# does not exist until you copy oidc.env.example to oidc.env; the "-" makes that fine.
EnvironmentFile=-/etc/pki-dash/oidc.env
ExecStart=/usr/bin/pki-dash
Restart=on-failure
RestartSec=5

# The database (and so the encrypted CA keys) lives here, readable by this user only.
StateDirectory=pki-dash
StateDirectoryMode=0700
UMask=0077

# Hardening: the process needs to write only to its state directory and to
# reach the network. It holds the keys of your CAs, so it gets no more than that.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# No capabilities. To listen on a port below 1024, add to a drop-in:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
# Password hashing uses about 64 MiB per concurrent login (at most 4 at a time).
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
