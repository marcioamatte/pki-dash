# pki-dash: main settings, read by the systemd unit.
# One KEY=value per line, no quotes. Every command-line option has an
# environment variable (see docs/02-deployment.md); these are the usual ones.
# After editing:  sudo systemctl restart pki-dash

# Where the dashboard listens. Keep it on one interface you trust.
PKI_DASH_LISTEN=127.0.0.1:8443

# The database, with the encrypted CA keys. The unit creates it, readable by the service only.
PKI_DASH_DATA_DIR=/var/lib/pki-dash

# --- How it is served: choose EXACTLY ONE of the three ----------------------
# (Two at once is as wrong as none: the server refuses to start and says which are on.)

# 1) Your certificate (the normal choice). The files must be readable by the
#    pki-dash group:  sudo chgrp pki-dash /etc/pki-dash/tls.key && sudo chmod 640 /etc/pki-dash/tls.key
#PKI_DASH_TLS_CERT=/etc/pki-dash/tls.crt
#PKI_DASH_TLS_KEY=/etc/pki-dash/tls.key

# 2) A throwaway self-signed certificate, for trying it out (browsers will warn).
#PKI_DASH_TLS_SELF_SIGNED=true

# 3) Plain HTTP, only behind a reverse proxy that terminates TLS (see below).
#PKI_DASH_INSECURE_HTTP=true

# --- Optional ---------------------------------------------------------------

# Behind a reverse proxy: the proxy's address(es), and bind to an address only it can reach.
#PKI_DASH_TRUSTED_PROXIES=10.0.0.5

# Publish CRLs and CA certificates over plain HTTP, and tell clients where they are.
#PKI_DASH_PKI_LISTEN=0.0.0.0:8080
#PKI_DASH_PUBLIC_URL=http://pki.lab:8080
